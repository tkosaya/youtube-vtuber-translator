{
  "manifest_version": 3,
  "name": "VTuber YouTube Translator",
  "description": "Personal YouTube caption translator for Japanese VTuber videos.",
  "version": "0.3.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VTuber Translator",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
